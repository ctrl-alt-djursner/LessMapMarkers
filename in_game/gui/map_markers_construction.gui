types construction_marker_types {
	type construction_marker = widget {
		hbox = {
			margin_bottom = 2
			widget = {
				using = layoutpolicy_expanding
				allow_outside = yes

				piechart = {
					parentanchor = center
					using = bg_circle_piechart
					block "piechart_size" {
						size = { 90% 90% }
					}
					using = piechart_angles

					pieslice_no_highlight = {
						texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
						value = "[Construction.GetProgress]"
						color = { 0.3 0.8 0.3 1 }
						alwaystransparent = yes
					}

					pieslice_no_highlight = {
						texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
						value = "[Construction.GetInverseProgress]"
						color = { 0.0 0.1 0.1 1 }
						alwaystransparent = yes
					}
				}

				button = {
					parentanchor = center
					allow_outside = yes
					block "button_size" {
						size = { 72% 72% }
					}

					texture = "gfx/interface/buttons/round_button_alt.dds"
					texture_density = 2
					onmousehierarchyenter = "[PdxGuiWidget.SetHighlightLocation(Construction.GetLocation)]"
					onclick = "[ShowConstructionType(Construction.Self)]"
					onrightclick = "[ShowConstructionCancellationDialog(Construction.Self, '(bool)no')]"

					block "construction_marker_tooltip" {
						tooltipwidget = {
							using = Construction_tooltip
						}
					}
					block "construction_marker_left_action" {}
				}

				icon = {
					parentanchor = center
					size = { 40% 40% }
					texture = "gfx/interface/icons/unit_types/construction.dds"
					texture_density = 2
				}
				
				icon = {
					visible = "[Construction.IsStalled]"
					size = { 50% 50% }
					parentanchor = vcenter|hcenter
					using = icon_locked
					using = overlay_color_red
				}
			}
		}
	}
}

construction_marker = {
	name = "building_construction_marker"
	size = { 50 50 }
	position = { 0 2 }
	datacontext = "[BuildingConstructionMarker.GetConstruction]"
	visible = "[BuildingConstructionMarker.GetConstruction.GetCountry.IsPlayer]"
	allow_outside = yes
}

